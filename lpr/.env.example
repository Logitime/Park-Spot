# ParkSpot LPR service — copy to .env and fill in.

# --- Camera ---------------------------------------------------------------
LPR_SOURCE=rtsp                          # rtsp | usb
LPR_CAMS_RTSP=rtsp://admin:pass@192.168.1.64:554/Streaming/Channels/101
LPR_CAM_DEVICE=0
LPR_CAM_FPS=15
# roi as four comma floats: LPR_ROI=0.1,0.2,0.9,0.9

# --- Detection / OCR models ------------------------------------------------
LPR_DET_MODEL=models/egypt_plate_yolov8n.pt
LPR_DET_DEVICE=0
LPR_OCR_MODEL=models/egypt_char_cnn.onnx
# Set LPR_OCR_DEMO=true to run without trained models (demo plate reads).
LPR_OCR_DEMO=false

# --- ParkSpot API ----------------------------------------------------------
PARKSPOT_API_URL=http://localhost:4000
# Bearer JWT of an ADMIN or OPERATOR account (POST /api/auth/login):
PARKSPOT_TOKEN=

# --- Siemens LOGO! ---------------------------------------------------------
LOGO_IP=192.168.0.10
LOGO_PORT=502
LPR_GATE_ENABLED=true
# Set false while developing on the bench (uses the simulated PLC):
# LPR_GATE_ENABLED=false